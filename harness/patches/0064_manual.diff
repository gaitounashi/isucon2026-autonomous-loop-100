+// Fast JPEG Dimensions parser via SOF0/SOF2 marker scan (bypasses full pixel decoding)
+func parseJPEGDimensions(data []byte) (int, int, error) {
+	if len(data) < 4 || data[0] != 0xFF || data[1] != 0xD8 {
+		return 0, 0, fmt.Errorf("invalid jpeg marker")
+	}
+	i := 2
+	for i < len(data)-8 {
+		if data[i] != 0xFF {
+			i++
+			continue
+		}
+		marker := data[i+1]
+		if marker == 0xC0 || marker == 0xC1 || marker == 0xC2 {
+			h := int(data[i+5])<<8 | int(data[i+6])
+			w := int(data[i+7])<<8 | int(data[i+8])
+			return w, h, nil
+		}
+		if marker == 0xDA || marker == 0xD9 {
+			break
+		}
+		if i+3 >= len(data) {
+			break
+		}
+		segLen := int(data[i+2])<<8 | int(data[i+3])
+		i += 2 + segLen
+	}
+	return 0, 0, fmt.Errorf("SOF marker not found")
+}
